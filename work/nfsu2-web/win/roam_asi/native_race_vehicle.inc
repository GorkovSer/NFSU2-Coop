static nv_slot NV_RACE;
static nv_slot NV_OWNER;
static void nv_owner_cleanup(CPU *c){
 /* An attached human model remains in use through results/cancellation.
  * Release its resources only after that world is gone. */
 if(NV_OWNER.started&&world()!=NV_OWNER.world)nv_reset(c,&NV_OWNER);
}
#include "vehicle_sync.h"
static vs_barrier NV_BARRIER;
static uint32_t NV_LOADED_DIGEST;
static struct {
 uint8_t bytes[RC_CFG_MAX];int length,valid,finalized;
 uint32_t run,event,peer,digest,physics;
 char profile[17];rc_carcfg cfg;
} NV_FROZEN;
static int nv_cfg_pinned(void){return NV_FROZEN.valid;}
void nv_solo_start(void){NV_FROZEN.valid=NV_FROZEN.finalized=0;}
static void nv_race_release(CPU *c){
 nv_owner_cleanup(c);
 if(NV_OWNER.started&&!NV_OWNER.applied)nv_reset(c,&NV_OWNER);
 nai_release(c);
 nv_reset(c,&NV_RACE);memset(&NV_BARRIER,0,sizeof NV_BARRIER);NV_LOADED_DIGEST=0;
 NV_FROZEN.valid=NV_FROZEN.finalized=0;
}
static void nv_publish_local(void){
 uint8_t bytes[RC_CFG_MAX];char name[RC_CFG_TYPE_NAME+1];int n=local_cfg(bytes,sizeof bytes,name);
 if(n>0){roam_plat_lock();rc_set_cfg(&g_s,bytes,n,roam_plat_now_us());roam_plat_unlock();}
}
/* Freeze the real human car before the native start destroys the free-roam
 * world. Never substitute the bot record generated by race loading. */
static int nv_freeze_race(CPU *c,uint32_t peer,uint32_t run,uint32_t event,int64_t now){
 (void)c;
 if(NV_FROZEN.valid)return NV_FROZEN.peer==peer&&NV_FROZEN.run==run&&NV_FROZEN.event==event;
 uint32_t car=player_car(),ride=rd32(car+0x10);char name[RC_CFG_TYPE_NAME+1];
 if(!ok(car,0x9e0)||!ok(ride,0x8f0)||rd32(car+0x20)!=ride+0x40)return 0;
 int n=local_cfg(NV_FROZEN.bytes,sizeof NV_FROZEN.bytes,name);
 if(n<=0||rc_carcfg_decode(NV_FROZEN.bytes,n,&NV_FROZEN.cfg)!=RC_OK||!NV_FROZEN.cfg.has_perf)return 0;
 cstr(G_PROFILE_NAME,NV_FROZEN.profile,sizeof NV_FROZEN.profile);if(!NV_FROZEN.profile[0])return 0;
 if(!nv_matches_cfg(&NV_FROZEN.cfg,ride)||!nv_physics_signature(ride,&NV_FROZEN.physics))return 0;
 NV_FROZEN.peer=peer;NV_FROZEN.run=run;NV_FROZEN.event=event;NV_FROZEN.length=n;
 NV_FROZEN.digest=rc_fnv1a_bytes(NV_FROZEN.bytes,(uint32_t)n);
 /* The CFG server must retain these exact bytes throughout loading/racing. */
 roam_plat_lock();rc_set_cfg(&g_s,NV_FROZEN.bytes,n,now);roam_plat_unlock();NV_FROZEN.finalized=0;NV_FROZEN.valid=1;
 rlog("[vehicle] pre-load freeze: %s, %u parts, cfg %08x physics %08x run %08x\n",name,NV_FROZEN.cfg.n_parts,NV_FROZEN.digest,NV_FROZEN.physics,run);
 return 1;
}
static int nv_finalize_owner(uint32_t car,int64_t now){
 if(!NV_FROZEN.valid||NV_FROZEN.finalized||car!=player_car()||!ok(car,0x9e0))return 0;
 uint32_t ride=rd32(car+0x10),physical=0;
 /* Preserve the pre-load type, installed upgrades and appearance. If the
  * native human car selects a race-specific tuning setup, freeze that setup
  * now, once, before advertising its digest. Never read an AI/bot's car. */
 if(rd32(car+0x20)!=ride+0x40||!nv_matches_equipment(&NV_FROZEN.cfg,ride,0)||
    !nv_physics_signature(ride,&physical))return 0;
 uint8_t bytes[RC_CFG_MAX];char name[RC_CFG_TYPE_NAME+1];rc_carcfg cfg;
 int n=local_cfg(bytes,sizeof bytes,name);
 if(n<=0||rc_carcfg_decode(bytes,n,&cfg)!=RC_OK||!nv_matches_cfg(&cfg,ride))return 0;
 memcpy(NV_FROZEN.bytes,bytes,n);NV_FROZEN.length=n;NV_FROZEN.cfg=cfg;
 NV_FROZEN.digest=rc_fnv1a_bytes(bytes,(uint32_t)n);NV_FROZEN.physics=physical;
 vs_init(&NV_BARRIER,g_s.conf.self_id,NV_FROZEN.peer,NV_FROZEN.run,NV_FROZEN.event,NV_FROZEN.digest);
 if(!vs_expect_physics(&NV_BARRIER,physical))return 0;
 roam_plat_lock();rc_set_cfg(&g_s,bytes,n,now);roam_plat_unlock();NV_FROZEN.finalized=1;
 rlog("[vehicle] owner race tuning finalized: %s cfg %08x physics %08x\n",name,NV_FROZEN.digest,physical);
 return 1;
}
